  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>dm_ventas</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SELECTCOLUMNS(
		KEEPFILTERS(
			FILTER(
				KEEPFILTERS(
					SUMMARIZECOLUMNS(
						'DimCliente'[ClienteId],
						'DimCliente'[Cliente],
						'DimCliente'[Ciudad],
						'DimCliente'[Estado],
						'DimCliente'[Segmento],
						'DimFecha'[Fecha],
						'DimFecha'[Anio],
						'DimFecha'[MesNumero],
						'DimFecha'[AnioMes],
						'DimFecha'[Trimestre],
						'DimSucursal'[SucursalId],
						'DimSucursal'[Sucursal],
						'DimSucursal'[Ciudad],
						'DimSucursal'[Estado],
						"CountRowsFactVentas", COUNTROWS('FactVentas')
					)
				),
				OR(
					OR(
						OR(
							OR(
								OR(
									OR(
										OR(
											OR(
												OR(
													OR(
														OR(
															OR(
																OR(
																	NOT(ISBLANK('DimCliente'[ClienteId])),
																	NOT(ISBLANK('DimCliente'[Cliente]))
																),
																NOT(ISBLANK('DimCliente'[Ciudad]))
															),
															NOT(ISBLANK('DimCliente'[Estado]))
														),
														NOT(ISBLANK('DimCliente'[Segmento]))
													),
													NOT(ISBLANK('DimFecha'[Fecha]))
												),
												NOT(ISBLANK('DimFecha'[Anio]))
											),
											NOT(ISBLANK('DimFecha'[MesNumero]))
										),
										NOT(ISBLANK('DimFecha'[AnioMes]))
									),
									NOT(ISBLANK('DimFecha'[Trimestre]))
								),
								NOT(ISBLANK('DimSucursal'[SucursalId]))
							),
							NOT(ISBLANK('DimSucursal'[Sucursal]))
						),
						NOT(ISBLANK('DimSucursal'[Ciudad]))
					),
					NOT(ISBLANK('DimSucursal'[Estado]))
				)
			)
		),
		"'DimCliente'[ClienteId]", 'DimCliente'[ClienteId],
		"'DimCliente'[Cliente]", 'DimCliente'[Cliente],
		"'DimCliente'[Ciudad]", 'DimCliente'[Ciudad],
		"'DimCliente'[Estado]", 'DimCliente'[Estado],
		"'DimCliente'[Segmento]", 'DimCliente'[Segmento],
		"'DimFecha'[Fecha]", 'DimFecha'[Fecha],
		"'DimFecha'[Anio]", 'DimFecha'[Anio],
		"'DimFecha'[MesNumero]", 'DimFecha'[MesNumero],
		"'DimFecha'[AnioMes]", 'DimFecha'[AnioMes],
		"'DimFecha'[Trimestre]", 'DimFecha'[Trimestre],
		"'DimSucursal'[SucursalId]", 'DimSucursal'[SucursalId],
		"'DimSucursal'[Sucursal]", 'DimSucursal'[Sucursal],
		"'DimSucursal'[Ciudad]", 'DimSucursal'[Ciudad],
		"'DimSucursal'[Estado]", 'DimSucursal'[Estado]
	)

EVALUATE
	__DS0Core

ORDER BY
	'DimCliente'[ClienteId],
	'DimCliente'[Cliente],
	'DimCliente'[Ciudad],
	'DimCliente'[Estado],
	'DimCliente'[Segmento],
	'DimFecha'[Fecha],
	'DimFecha'[Anio],
	'DimFecha'[MesNumero],
	'DimFecha'[AnioMes],
	'DimFecha'[Trimestre],
	'DimSucursal'[SucursalId],
	'DimSucursal'[Sucursal],
	'DimSucursal'[Ciudad],
	'DimSucursal'[Estado]</CommandText>
