  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>dm_ventas</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZE(
		'DimCliente',
		'DimCliente'[ClienteId],
		'DimCliente'[Cliente],
		'DimCliente'[Ciudad],
		'DimCliente'[Estado],
		'DimCliente'[Segmento]
	)

EVALUATE
	__DS0Core

ORDER BY
	'DimCliente'[ClienteId],
	'DimCliente'[Cliente],
	'DimCliente'[Ciudad],
	'DimCliente'[Estado],
	'DimCliente'[Segmento]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZE(
			'DimCliente',
			'DimCliente'[ClienteId],
			'DimCliente'[Cliente],
			'DimCliente'[Ciudad],
			'DimCliente'[Estado],
			'DimCliente'[Segmento]
		)

	VAR __DS0BodyLimited = 
		TOPN(
			500,
			__DS0Core,
			'DimCliente'[ClienteId],
			1,
			'DimCliente'[Cliente],
			1,
			'DimCliente'[Ciudad],
			1,
			'DimCliente'[Estado],
			1,
			'DimCliente'[Segmento],
			1
		)

EVALUATE
	__DS0BodyLimited

ORDER BY
	'DimCliente'[ClienteId],
	'DimCliente'[Cliente],
	'DimCliente'[Ciudad],
	'DimCliente'[Estado],
	'DimCliente'[Segmento]</wa:PreviewCommandText>
